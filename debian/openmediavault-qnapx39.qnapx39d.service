[Unit]
Description=QNAP TS-x39 fan control (openmediavault-qnapx39)
After=systemd-modules-load.service
ConditionPathExists=/etc/qnapx39d/qnapx39d.json
# Every Apply restarts the daemon; never give up restarting it.
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStartPre=-/sbin/modprobe -q it87
ExecStart=/usr/sbin/qnapx39d run
# After a clean stop and after a crash: never leave the fans slow.
ExecStopPost=/usr/sbin/qnapx39d failsafe
Restart=always
RestartSec=10
RuntimeDirectory=qnapx39d
RuntimeDirectoryMode=0755
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes

[Install]
WantedBy=multi-user.target
