#!/bin/sh
#
# This file is part of openmediavault-qnapx39 (GPL-3.0-or-later).

set -e

OMV_AVAILABLE=false
if [ -f /etc/default/openmediavault ] && [ -f /usr/share/openmediavault/scripts/helper-functions ]; then
    . /etc/default/openmediavault
    . /usr/share/openmediavault/scripts/helper-functions
    OMV_AVAILABLE=true
fi

case "$1" in
    purge)
        if [ "${OMV_AVAILABLE}" = "true" ]; then
            dpkg-trigger update-workbench
            omv_config_delete "/config/services/qnapx39"
        fi
        rm -rf /etc/qnapx39d /var/lib/rrdcached/db/localhost/exec-qnapx39
        rm -f /var/lib/openmediavault/rrd/exec-qnapx39-*.png
        rm -f /etc/modules-load.d/openmediavault-qnapx39.conf
    ;;

    remove)
        if [ "${OMV_AVAILABLE}" = "true" ]; then
            dpkg-trigger update-workbench
        fi
        if [ -f /etc/collectd/collectd.conf.d/qnapx39.conf ]; then
            rm -f /etc/collectd/collectd.conf.d/qnapx39.conf
            deb-systemd-invoke try-restart collectd.service || :
        fi
    ;;

    upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
    ;;

    *)
        echo "postrm called with unknown argument '$1'" >&2
        exit 1
    ;;
esac

#DEBHELPER#

exit 0
