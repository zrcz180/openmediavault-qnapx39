{
	"type": "config",
	"id": "conf.service.qnapx39",
	"title": "QNAP TS-x39 hardware",
	"queryinfo": {
		"xpath": "//services/qnapx39",
		"iterable": false
	},
	"properties": {
		"enable": {
			"type": "boolean",
			"default": false
		},
		"interval": {
			"type": "integer",
			"default": 10,
			"minimum": 2,
			"maximum": 120
		},
		"fanmode": {
			"type": "string",
			"default": "normal",
			"enum": [
				"quiet",
				"normal",
				"performance",
				"auto",
				"manual"
			]
		},
		"manualpwm": {
			"type": "integer",
			"default": 128,
			"minimum": 0,
			"maximum": 255
		},
		"minpwm": {
			"type": "integer",
			"default": 77,
			"minimum": 0,
			"maximum": 255
		},
		"maxpwm": {
			"type": "integer",
			"default": 255,
			"minimum": 0,
			"maximum": 255
		},
		"hysteresis": {
			"type": "integer",
			"default": 3,
			"minimum": 0,
			"maximum": 15
		},
		"usecpu": {
			"type": "boolean",
			"default": true
		},
		"cpulow": {
			"type": "integer",
			"default": 60,
			"minimum": 0,
			"maximum": 110
		},
		"cpuhigh": {
			"type": "integer",
			"default": 85,
			"minimum": 0,
			"maximum": 110
		},
		"usesystem": {
			"type": "boolean",
			"default": true
		},
		"syslow": {
			"type": "integer",
			"default": 45,
			"minimum": 0,
			"maximum": 110
		},
		"syshigh": {
			"type": "integer",
			"default": 60,
			"minimum": 0,
			"maximum": 110
		},
		"systemsensors": {
			"type": "string",
			"default": "temp1,temp2,temp3",
			"pattern": "^(temp[1-3])(,temp[1-3])*$"
		},
		"usedisk": {
			"type": "boolean",
			"default": true
		},
		"disklow": {
			"type": "integer",
			"default": 38,
			"minimum": 0,
			"maximum": 110
		},
		"diskhigh": {
			"type": "integer",
			"default": 50,
			"minimum": 0,
			"maximum": 110
		},
		"diskinterval": {
			"type": "integer",
			"default": 300,
			"minimum": 10,
			"maximum": 3600
		},
		"fans": {
			"type": "string",
			"default": "1,2",
			"pattern": "^[1-3](,[1-3])*$"
		},
		"loadmodule": {
			"type": "boolean",
			"default": true
		},
		"leds": {
			"type": "boolean",
			"default": true
		},
		"bays": {
			"type": "string",
			"default": "pci-0000:00:1f.1-ata-1,pci-0000:03:00.0-ata-2,pci-0000:03:00.0-ata-3,pci-0000:03:00.0-ata-4,pci-0000:04:00.0-ata-1,pci-0000:04:00.0-ata-2",
			"pattern": "^((ata[0-9]+|pci-[0-9a-f:.]+-ata-[0-9]+)(,|$)){1,6}$"
		},
		"lcd": {
			"type": "boolean",
			"default": true
		},
		"lcdtimeout": {
			"type": "integer",
			"default": 60,
			"minimum": 0,
			"maximum": 3600
		},
		"lcdpower": {
			"type": "boolean",
			"default": true
		},
		"beep": {
			"type": "boolean",
			"default": false
		},
		"usbcopytask": {
			"type": "string",
			"default": ""
		},
		"resettask": {
			"type": "string",
			"default": ""
		},
		"statusled": {
			"type": "boolean",
			"default": true
		},
		"volumefull": {
			"type": "integer",
			"default": 95,
			"minimum": 50,
			"maximum": 100
		},
		"night": {
			"type": "boolean",
			"default": false
		},
		"nightstart": {
			"type": "string",
			"default": "22:00",
			"pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
		},
		"nightend": {
			"type": "string",
			"default": "07:00",
			"pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
		},
		"powerloss": {
			"type": "string",
			"enum": ["bios", "on", "off"],
			"default": "bios"
		}
	}
}
