[
	{
		"type": "rpc",
		"id": "rpc.qnapx39.setsettings",
		"params": {
			"type": "object",
			"properties": {
				"enable": {
					"type": "boolean",
					"required": true
				},
				"interval": {
					"type": "integer",
					"minimum": 2,
					"maximum": 120,
					"required": true
				},
				"fanmode": {
					"type": "string",
					"enum": [
						"auto",
						"manual"
					],
					"required": true
				},
				"manualspeed": {
					"type": "integer",
					"minimum": 0,
					"maximum": 100,
					"required": true
				},
				"minspeed": {
					"type": "integer",
					"minimum": 0,
					"maximum": 100,
					"required": true
				},
				"maxspeed": {
					"type": "integer",
					"minimum": 0,
					"maximum": 100,
					"required": true
				},
				"hysteresis": {
					"type": "integer",
					"minimum": 0,
					"maximum": 15,
					"required": true
				},
				"usecpu": {
					"type": "boolean",
					"required": true
				},
				"cpulow": {
					"type": "integer",
					"minimum": 0,
					"maximum": 110,
					"required": true
				},
				"cpuhigh": {
					"type": "integer",
					"minimum": 0,
					"maximum": 110,
					"required": true
				},
				"usesystem": {
					"type": "boolean",
					"required": true
				},
				"syslow": {
					"type": "integer",
					"minimum": 0,
					"maximum": 110,
					"required": true
				},
				"syshigh": {
					"type": "integer",
					"minimum": 0,
					"maximum": 110,
					"required": true
				},
				"systemsensors": {
					"type": "string",
					"pattern": "^(temp[1-3])(,temp[1-3])*$",
					"required": true
				},
				"usedisk": {
					"type": "boolean",
					"required": true
				},
				"disklow": {
					"type": "integer",
					"minimum": 0,
					"maximum": 110,
					"required": true
				},
				"diskhigh": {
					"type": "integer",
					"minimum": 0,
					"maximum": 110,
					"required": true
				},
				"diskinterval": {
					"type": "integer",
					"minimum": 10,
					"maximum": 3600,
					"required": true
				},
				"lcdpower": {
					"type": "boolean",
					"required": true
				},
				"fans": {
					"type": "string",
					"pattern": "^[1-3](,[1-3])*$",
					"required": true
				},
				"loadmodule": {
					"type": "boolean",
					"required": true
				},
				"leds": {
					"type": "boolean",
					"required": true
				},
				"bays": {
					"type": "string",
					"pattern": "^((ata[0-9]+|pci-[0-9a-f:.]+-ata-[0-9]+)(,|$)){1,6}$",
					"required": true
				},
				"lcd": {
					"type": "boolean",
					"required": true
				},
				"lcdtimeout": {
					"type": "integer",
					"minimum": 0,
					"maximum": 3600,
					"required": true
				}
			}
		}
	},
	{
		"type": "rpc",
		"id": "rpc.qnapx39.setbuttonsettings",
		"params": {
			"type": "object",
			"properties": {
				"beep": {
					"type": "boolean",
					"required": true
				},
				"usbcopytask": {
					"type": "string",
					"oneOf": [{
						"type": "string",
						"format": "uuidv4"
					}, {
						"type": "string",
						"maxLength": 0
					}],
					"required": true
				},
				"resettask": {
					"type": "string",
					"oneOf": [{
						"type": "string",
						"format": "uuidv4"
					}, {
						"type": "string",
						"maxLength": 0
					}],
					"required": true
				}
			}
		}
	}
]
