    # Set by Salt: {"script": ..., "user": ...} of the chosen Scheduled Task.
    "usbcopy": None,
    "reset": None,
}

log = logging.getLogger("qnapx39d")


# --------------------------------------------------------------------------
# sysfs helpers
# --------------------------------------------------------------------------

def sysfs(*parts):
    return os.path.join(SYSFS, *parts)


def read(path):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return None


def read_int(path):
    value = read(path)
    try:
        return int(value)
    except (TypeError, ValueError):
        return None


def write(path, value):
    with open(path, "w") as f:
        f.write(str(value))


def find_hwmon(predicate):
    """First /sys/class/hwmon/hwmonN whose name matches."""
    for path in sorted(glob.glob(sysfs("class", "hwmon", "hwmon*"))):
        name = read(os.path.join(path, "name")) or ""
        if predicate(name):
            return path
    return None


def plausible(temp):
    lo, hi = PLAUSIBLE_TEMP
    return temp is not None and lo <= temp <= hi


def millidegrees(path):
    value = read_int(path)
    return value / 1000.0 if value is not None else None


def parse_list(text, cast=str):
    return [cast(x.strip()) for x in str(text).split(",") if x.strip()]


# --------------------------------------------------------------------------
# Sensors
# --------------------------------------------------------------------------

class SuperIO:
    """The IT8718F (it87 driver): fans, PWM and board temperatures."""

    def __init__(self, path):
        self.path = path
        self.name = read(os.path.join(path, "name"))

    @classmethod
    def find(cls):
        path = find_hwmon(lambda n: n.startswith("it87"))
        return cls(path) if path else None

    def temps(self, names):
        result = []
        for name in names:
            temp = millidegrees(os.path.join(self.path, name + "_input"))
            if plausible(temp):
                result.append((name, temp))
        return result

    def rpm(self, n):
        return read_int(os.path.join(self.path, "fan%d_input" % n))

    def pwm(self, n):
        return read_int(os.path.join(self.path, "pwm%d" % n))

    def set_pwm(self, n, value):
        value = min(PWM_MAX, max(0, int(value)))
        enable = os.path.join(self.path, "pwm%d_enable" % n)
        if read_int(enable) != 1:
            write(enable, 1)  # manual mode
        write(os.path.join(self.path, "pwm%d" % n), value)
        return self.pwm(n)


def cpu_temps():
    """Core temperatures from coretemp."""
    path = find_hwmon(lambda n: n == "coretemp")
    if not path:
        return []
    result = []
    for f in sorted(glob.glob(os.path.join(path, "temp*_input"))):
        temp = millidegrees(f)
        if plausible(temp):
            label = read(f.replace("_input", "_label")) or "cpu"
            result.append((label, temp))
    return result


class DiskTemps:
    """SATA disk temperatures via smartctl, cached between polls.

    Disks in standby are never woken (smartctl -n standby). Awake disks
    with no I/O since their last query keep their last reading, because a
    S.M.A.R.T. read restarts the standby timer of many drives.
    """

    IDLE_REFRESH_SECONDS = 1800

    def __init__(self, interval):
        self.interval = interval
        self.last = None
        self.cache = []
        self.queried = {}   # dev -> (time, I/O count)
        self.readings = {}  # dev -> (dev, temperature)
        self.asleep = set()
        # Disks whose last S.M.A.R.T. health check failed. Disks in standby
        # keep their previous verdict.
        self.failed = set()

    def get(self, now):
        if self.last is None or now - self.last >= self.interval:
            self.last = now
            self.cache = self.refresh(now)
        return self.cache

    @staticmethod
    def devices():
        """Internal disks only: USB disks are outside the case airflow."""
        result = []
        for path in sorted(glob.glob(sysfs("block", "sd*"))):
            if read(os.path.join(path, "removable")) == "1":
                continue
            if re.search(r"/usb\d+/", os.path.realpath(path)):
                continue
            result.append(os.path.basename(path))
        return result

    def refresh(self, now):
        result = []
        for dev in self.devices():
            ios = io_count(dev)
            when, last_ios = self.queried.get(dev, (None, None))
            if ios is not None and ios == last_ios and \
                    now - when < self.IDLE_REFRESH_SECONDS and \
                    dev not in self.asleep:
                if dev in self.readings:
                    result.append(self.readings[dev])
                continue
            self.queried[dev] = (now, ios)
            self.readings.pop(dev, None)
            try:
                proc = subprocess.run(
                    ["smartctl", "-n", "standby", "-A", "-H", "-j",
                     "/dev/" + dev],
                    capture_output=True, text=True, timeout=20)
                data = json.loads(proc.stdout or "{}")
            except (OSError, subprocess.SubprocessError, ValueError):
                continue
            temp = parse_smart_temp(data)
            # smartctl exits with 2 for a disk in standby.
            if temp is None and proc.returncode == 2:
                self.asleep.add(dev)
            else:
                self.asleep.discard(dev)
            if plausible(temp):
                self.readings[dev] = (dev, temp)
                result.append(self.readings[dev])
            passed = parse_smart_health(data)
            if passed is False:
                self.failed.add(dev)
            elif passed is True:
                self.failed.discard(dev)
        return result


def io_count(dev):
    """Reads plus writes completed by a block device, or None."""
    stat = (read(sysfs("block", dev, "stat")) or "").split()
    return int(stat[0]) + int(stat[4]) if len(stat) >= 5 else None


def parse_smart_temp(data):
    temp = (data.get("temperature") or {}).get("current")
    return float(temp) if isinstance(temp, (int, float)) else None


def parse_smart_health(data):
    """True/False from smartctl -H -j, None when not reported."""
    passed = (data.get("smart_status") or {}).get("passed")
    return passed if isinstance(passed, bool) else None


def disk_name(path):
    """sda for /dev/sda1 or sda1."""
    match = re.match(r"([a-z]+?d[a-z]+)", os.path.basename(path))
    return match.group(1) if match else None


def md_faulty(text):
    """Disks marked faulty (F) in /proc/mdstat."""
    return {disk_name(m) for m in re.findall(r"(\w+)\[\d+\]\(F\)", text)
            if disk_name(m)}


def md_degraded(text):
    """True when an md array misses a member ([UU_] style status)."""
    return any("_" in m for m in re.findall(r"\[([U_]+)\]", text))


def disk_port(dev):
    """The stable name of the SATA port a disk is on, as udev names it in
    /dev/disk/by-path (pci-0000:03:00.0-ata-1), or None.

    The kernel's ataN numbers depend on the order the controllers are
    probed and change between boots; the PCI address of the controller
    and the port number on it do not.
    """
    real = os.path.realpath(sysfs("block", dev))
    match = re.search(r"/([0-9a-f]{4}:[0-9a-f]{2}:[0-9a-f]{2}\.[0-7])/"
                      r"(ata\d+)/", real)
    if not match:
        return None
    port = read_int(sysfs("class", "ata_port", match.group(2), "port_no"))
    if port is None:
        return None
    return "pci-%s-ata-%d" % (match.group(1), port)


def disk_bays(ports):
    """{bay number: disk}. Bay N is the Nth port listed: a by-path port
    name (pci-0000:03:00.0-ata-1) or, as before 7.2.3, a kernel ataN."""
    result = {}
    for path in sorted(glob.glob(sysfs("block", "sd*"))):
        dev = os.path.basename(path)
        real = os.path.realpath(path)
        stable = disk_port(dev)
        for bay, port in enumerate(ports, 1):
            if port == stable or (port.startswith("ata") and
                                  "/%s/" % port in real):
                result[bay] = dev
    return result


def size_text(sectors):
    """1.8T, 500G... from a count of 512-byte sectors."""
    size = sectors * 512 / 1000.0 ** 3
    if size >= 1000:
        return "%.1fT" % (size / 1000)
    return "%.0fG" % size


def bay_info(ports, readings, asleep, failed_bays):
    """One entry per bay: disk, model, size, temperature and state."""
    bays = disk_bays(ports)
    temps = dict(readings)
    result = []
    for bay in range(1, len(ports) + 1):
        dev = bays.get(bay)
        if not dev:
            result.append({"bay": bay, "dev": None, "state": "empty"})
            continue
        model = " ".join((read(sysfs("block", dev, "device", "model"))
                          or "").split())
        result.append({
            "bay": bay, "dev": dev, "model": model,
            "size": size_text(read_int(sysfs("block", dev, "size")) or 0),
            "temp": temps.get(dev),
            "state": "FAILED" if bay in failed_bays else
                     "sleep" if dev in asleep else "OK"})
    return result


# --------------------------------------------------------------------------
# Front panel LEDs (IT8718F GPIO)
# --------------------------------------------------------------------------

class PortIO:
    """Byte access to x86 I/O ports through /dev/port."""

    def __init__(self):
        self.fd = os.open(PORT_DEVICE, os.O_RDWR)

    # pread/pwrite: the LED, LCD and button threads share no file offset.
    def outb(self, addr, value):
        os.pwrite(self.fd, bytes([value]), addr)

    def inb(self, addr):
        return os.pread(self.fd, 1, addr)[0]


class SuperIOConfig:
    """IT8718F configuration space (index/data ports 0x2E/0x2F)."""

    INDEX = 0x2E
    KEY = bytes([0x87, 0x01, 0x55, 0x55])
    LDN_GPIO = 0x07

    def __init__(self, io):
        self.io = io

    def __enter__(self):
        for b in self.KEY:
            self.io.outb(self.INDEX, b)
        return self

    def __exit__(self, *exc):
        self.io.outb(self.INDEX, 0x02)
        self.io.outb(self.INDEX + 1, 0x02)

    def reg(self, r, value=None):
        self.io.outb(self.INDEX, r)
        if value is None:
            return self.io.inb(self.INDEX + 1)
        self.io.outb(self.INDEX + 1, value)
        return value

    def gpio(self):
        """(chip id, Simple I/O base, [blink pin location registers])."""
        chip = self.reg(0x20) << 8 | self.reg(0x21)
        self.reg(0x07, self.LDN_GPIO)
        base = self.reg(0x62) << 8 | self.reg(0x63)
        return chip, base, [self.reg(0xF8), self.reg(0xFA)]


class FrontPanel:
    """TS-639 Pro front panel. Pins are (GPIO set, bit), all active-low,
    mapped by flipping each pin on a TS-639 Pro."""

    STATUS_GREEN = (3, 5)   # GP35
    STATUS_RED = (3, 4)     # GP34
    USB = (5, 0)            # GP50, blue
    # The BIOS blinks the green Status LED with blink generator 1 on GP26
    # (location 0x16); unmapping it leaves the LED solid (checked on the
    # NAS with tools/it8718-blink-test.py).
    STATUS_BLINK = (2, 6)
    DISK_RED = {1: (2, 3), 2: (2, 2), 3: (2, 1), 4: (2, 0),
                5: (3, 1), 6: (3, 0)}

    def __init__(self, io, base, blink, config=None):
        self.io = io
        self.base = base
        self.config = config  # SuperIOConfig, to stop hardware blinking
        self.blink = list(blink)
        self.unmapped = {}
        self.usb_busy = False
        pins = [self.STATUS_GREEN, self.STATUS_RED, self.USB] + \
            list(self.DISK_RED.values())
        self.original = {s: self.io.inb(base + s - 1)
                         for s in {s for s, _ in pins}}
        self.mask = {}
        for s, bit in pins:
            self.mask[s] = self.mask.get(s, 0) | 1 << bit

    @classmethod
    def open(cls):
        io = PortIO()
        config = SuperIOConfig(io)
        with config:
            chip, base, blink = config.gpio()
        if chip != 0x8718 or not base:
            raise OSError("no IT8718F GPIO (chip 0x%04X, base 0x%04X)"
                          % (chip, base))
        return cls(io, base, blink, config)

    @staticmethod
    def location(pin):
        s, bit = pin
        return s << 3 | bit

    def set(self, pin, on):
        s, bit = pin
        addr = self.base + s - 1
        value = self.io.inb(addr)
        value = value & ~(1 << bit) if on else value | 1 << bit
        self.io.outb(addr, value)

    def stop_blink(self, pin):
        """The BIOS blinks the green Status LED in hardware ("booting");
        unmap that pin from the blink generator so the LED stays on."""
        for n, loc in enumerate(self.blink):
            if loc == self.location(pin) and self.config and \
                    not self.unmapped.get(n):
                with self.config:
                    self.config.reg(0x07, SuperIOConfig.LDN_GPIO)
                    self.config.reg(0xF8 + 2 * n, 0)
                self.unmapped[n] = True

    def show(self, ok, failed_bays, usb=False, status=True, disks=True,
             night=False):
        """status / disks: drive those LEDs at all (else the BIOS state
        stays). At night the green Status LED is off; red still shows."""
        if status:
            self.stop_blink(self.STATUS_BLINK)
            self.set(self.STATUS_GREEN, ok and not night)
            self.set(self.STATUS_RED, not ok)
        if disks:
            if not self.usb_busy:   # USB Copy drives the USB LED meanwhile
                self.set(self.USB, usb and not night)
            for bay, pin in self.DISK_RED.items():
                self.set(pin, bay in failed_bays)

    def restore(self):
        """Put our pins and the blink mapping back as the BIOS left them."""
        for s, orig in self.original.items():
            addr = self.base + s - 1
            value = self.io.inb(addr)
            self.io.outb(addr, value & ~self.mask[s] | orig & self.mask[s])
        if self.config:
            with self.config:
                self.config.reg(0x07, SuperIOConfig.LDN_GPIO)
                for n, loc in enumerate(self.blink):
                    self.config.reg(0xF8 + 2 * n, loc)


def usb_disk_present():
    """True while a USB disk is plugged in."""
    return any(re.search(r"/usb\d+/", os.path.realpath(path))
               for path in glob.glob(sysfs("block", "sd*")))


def panel_state(fans, disks, mdstat, bays):
    """(all well, {failed bay numbers}, [problems])."""
    problems = []
    faulty = set(disks.failed) | md_faulty(mdstat)
    failed_bays = {bay for bay, dev in bays.items() if dev in faulty}
    for fan in fans:
        if fan.get("failed"):
            problems.append("%s failed" % fan["name"])
    for dev in sorted(faulty):
        problems.append("disk %s failed" % dev)
    if md_degraded(mdstat):
        problems.append("RAID degraded")
    return not problems, failed_bays, problems


# --------------------------------------------------------------------------
# Front LCD
# --------------------------------------------------------------------------

def lcd_text(text):
    """16 printable ASCII characters."""
    text = "".join(c if " " <= c <= "~" else "?" for c in str(text))
    return text[:LCD_WIDTH].ljust(LCD_WIDTH)


def parse_buttons(buf):
    """([buttons pressed], unparsed rest) from bytes read off the LCD.

    The panel sends 53 05 00 bb: bb 01 = ENTER, 02 = SELECT, 00 = release.
    """
    pressed = []
    while True:
        start = buf.find(b"\x53\x05\x00")
        if start < 0:
            # Keep the start of a message cut off by the read.
            for n in (2, 1):
                if buf[-n:] == b"\x53\x05\x00"[:n]:
                    return pressed, buf[-n:]
            return pressed, b""
        if len(buf) < start + 4:
            return pressed, buf[start:]
        if buf[start + 3]:
            pressed.append(buf[start + 3])
        buf = buf[start + 4:]


class Lcd:
    """A125 2x16 front LCD of the TS-639 Pro, on /dev/ttyS1 at 1200 baud.

    GP10 (active-low) powers the panel: the BIOS leaves it at 1 and the
    LCD dark. Checked on a TS-639 Pro with tools/a125-lcd-*.py; no other
    program may have the port open (two writers make it flash).
    """

    POWER = (1, 0)  # GP10
    BACKLIGHT = b"\x4d\x5e"
    LINE = b"\x4d\x0c"

    def __init__(self, fd, io=None, base=None):
        self.fd = fd
        self.io = io
        self.base = base
        self.original = None
        self.lines = [None, None]
        self.lit = None
        self.buf = b""

    @classmethod
    def open(cls, tty):
        import termios
        io = PortIO()
        with SuperIOConfig(io) as config:
            chip, base, _ = config.gpio()
        if chip != 0x8718 or not base:
            raise OSError("no IT8718F GPIO (chip 0x%04X, base 0x%04X)"
                          % (chip, base))
        fd = os.open(tty, os.O_RDWR | os.O_NOCTTY | os.O_NONBLOCK)
        attrs = termios.tcgetattr(fd)
        attrs[0] = attrs[1] = attrs[3] = 0
        attrs[2] = termios.CS8 | termios.CREAD | termios.CLOCAL
        attrs[4] = attrs[5] = termios.B1200
        termios.tcsetattr(fd, termios.TCSANOW, attrs)
        termios.tcflush(fd, termios.TCIOFLUSH)
        lcd = cls(fd, io, base)
        lcd.power(True)
        return lcd

    def power(self, on):
        if self.io is None:
            return
        s, bit = self.POWER
        addr = self.base + s - 1
        value = self.io.inb(addr)
        if self.original is None:
            self.original = value & 1 << bit
        value = value & ~(1 << bit) if on else value | 1 << bit
        self.io.outb(addr, value)
        if on:
            time.sleep(0.5)  # let the panel start before talking to it

    def write(self, data):
        while data:
            try:
                data = data[os.write(self.fd, data):]
            except BlockingIOError:
                time.sleep(0.05)

    def backlight(self, on):
        if self.lit != on:
            self.write(self.BACKLIGHT + bytes([1 if on else 0]))
            self.lit = on

    def show(self, lines):
        """Write only the lines that changed: 1200 baud is slow.

        4D 0C <line> <length> then the text: the length byte must match
        the text sent (16), or the panel takes the next command as text.
        """
        for n, text in enumerate(lines[:2]):
            text = lcd_text(text)
            if self.lines[n] != text:
                self.write(self.LINE + bytes([n, LCD_WIDTH]) + text.encode())
                self.lines[n] = text

    def buttons(self, timeout):
        """Buttons pressed within `timeout` seconds."""
        import select
        ready, _, _ = select.select([self.fd], [], [], timeout)
        if not ready:
            return []
        try:
            self.buf += os.read(self.fd, 64)
        except (BlockingIOError, InterruptedError):
            return []
        pressed, self.buf = parse_buttons(self.buf)
        return pressed

    def close(self, message=None):
        try:
            if message:
                self.show(message)
            self.backlight(False)
            if self.io is not None and self.original is not None:
                # Back to how the BIOS left GP10 (normally: panel off).
                self.power(not self.original)
        finally:
            os.close(self.fd)


def ipv4_address(name):
    """The IPv4 address of a network interface, or None."""
    import fcntl
    import socket
    import struct
    try:
        with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as s:
            data = fcntl.ioctl(s.fileno(), SIOCGIFADDR,
                               struct.pack("256s", name.encode()[:15]))
        return socket.inet_ntoa(data[20:24])
    except OSError:
        return None


def network_interfaces():
    """[(name, IPv4 address or None, link text)] for the network ports.

    Physical ports (with a device in sysfs) are always listed, so an
    unplugged one shows as such; bridges, bonds and VLANs only when they
    have an address. Ports enslaved to a bridge or bond are left out: the
    address is on the bridge or bond.
    """
    result = []
    for path in sorted(glob.glob(sysfs("class", "net", "*"))):
        name = os.path.basename(path)
        if name == "lo" or os.path.exists(os.path.join(path, "master")):
            continue
        physical = os.path.exists(os.path.join(path, "device"))
        address = ipv4_address(name)
        if not physical and not address:
            continue
        if read(os.path.join(path, "operstate")) == "up":
            speed = read_int(os.path.join(path, "speed"))
            link = "%dMb" % speed if speed and speed > 0 else "up"
        else:
            link = "down"
        result.append((name, address, link))
    return result


def uptime_text():
    try:
        seconds = int(float(read("/proc/uptime").split()[0]))
        load = read("/proc/loadavg").split()[:3]
    except (AttributeError, IndexError, ValueError):
        return "", ""
    days, rest = divmod(seconds, 86400)
    return ("Up %dd %02d:%02d" % (days, rest // 3600, rest % 3600 // 60),
            "Load " + " ".join(load))


MOUNTS_FILE = "/proc/mounts"
VOLUMES_ROOT = "/srv/"
# Network and virtual file systems are not volumes of this NAS, and a
# hung network share would block statvfs.
NOT_VOLUMES = ("nfs", "nfs4", "cifs", "smb3", "sshfs", "fuse.sshfs",
               "tmpfs", "overlay", "squashfs", "autofs")


def md_arrays(text):
    """[{name, level, members, active, status, progress}] from mdstat."""
    result = []
    blocks = re.split(r"\n(?=md\d+\s*:)", text)
    for block in blocks:
        m = re.match(r"(md\d+)\s*:\s*(\w+)\s+(?:\([^)]*\)\s+)?(raid\d+|linear)?",
                     block)
        if not m:
            continue
        counts = re.search(r"\[(\d+)/(\d+)\]\s*\[([U_]+)\]", block)
        progress = re.search(r"(recovery|resync|reshape|check)\s*=\s*"
                             r"([\d.]+)%", block)
        result.append({
            "name": m.group(1), "state": m.group(2),
            "level": m.group(3) or "",
            "members": int(counts.group(1)) if counts else None,
            "active": int(counts.group(2)) if counts else None,
            "map": counts.group(3) if counts else "",
            "progress": (progress.group(1), float(progress.group(2)))
            if progress else None})
    return result


def volumes(mounts=None):
    """[(name, used %, free bytes, size bytes)] of the data volumes:
    file systems OpenMediaVault mounts under /srv, one per device."""
    try:
        with open(mounts or MOUNTS_FILE) as f:
            lines = f.read().splitlines()
    except OSError:
        return []
    result, seen = [], set()
    for line in lines:
        fields = line.split()
        if len(fields) < 3:
            continue
        dev, mnt, fstype = fields[0], fields[1].replace("\\040", " "), \
            fields[2]
        if not mnt.startswith(VOLUMES_ROOT) or fstype in NOT_VOLUMES or \
                dev in seen:
            continue
        seen.add(dev)
        try:
            st = os.statvfs(mnt)
        except OSError:
            continue
        size = st.f_blocks * st.f_frsize
        if not size:
            continue
        free = st.f_bavail * st.f_frsize
        used = (st.f_blocks - st.f_bfree) * st.f_frsize
        label = re.search(r"by-label-(.+)$", mnt)
        name = label.group(1) if label else \
            os.path.basename(os.path.realpath(dev)) if dev.startswith("/") \
            else os.path.basename(mnt)
        result.append((name, round(used * 100.0 / (used + free))
                       if used + free else 100, free, size))
    return result


def bytes_text(n):
    for unit in ("B", "K", "M", "G", "T", "P"):
        if n < 1000 or unit == "P":
            return ("%.1f%s" if n < 10 and unit != "B" else "%.0f%s") \
                % (n, unit)
        n /= 1000.0


POWER_PAGE = ("Shutdown/Reboot", "ENTER = menu")


def lcd_pages(status, hostname, interfaces, uptime=("", ""), power=False,
              arrays=(), vols=()):
    """The pages SELECT steps through, each two 16-character lines."""
    pages = []
    for name, address, link in interfaces:
        pages.append(("%s %s %s" % (hostname, name, link)
                      if len(hostname) + len(name) + len(link) < 15
                      else "%s %s" % (name, link),
                      address or "no IP address"))
    if not pages:
        pages.append((hostname, "no network"))
    problems = status.get("problems") or []
    if problems:
        pages.append(("Status: PROBLEM", problems[0]))
    else:
        pages.append(("Status: OK", "All well"))
    temps = status.get("temps") or {}
    cpu = max((t for _, t in temps.get("cpu") or []), default=None)
    system = max((t for _, t in temps.get("system") or []), default=None)
    pages.append(("CPU " + ("%.0fC" % cpu if cpu is not None else "-"),
                  "System " + ("%.0fC" % system if system is not None
                               else "-")))
    fans = status.get("fans") or []
    duty = status.get("duty")
    pages.append(("Fans " + ("%d%%" % duty if duty is not None else ""),
                  " ".join(str(f.get("rpm") if f.get("rpm") is not None
                               else "-") for f in fans) + " RPM"))
    disks = [t for _, t in temps.get("disk") or []]
    if disks:
        pages.append(("Disks %d, max %.0fC" % (len(disks), max(disks)),
                      "min %.0fC" % min(disks)))
    else:
        pages.append(("Disks", "asleep/no data"))
    for b in status.get("bays") or []:
        if not b.get("dev"):
            pages.append(("Bay %d" % b["bay"], "empty"))
            continue
        temp = "%.0fC" % b["temp"] if b.get("temp") is not None else ""
        state = "FAIL" if b["state"] == "FAILED" else b["state"]
        pages.append(("B%d %s %s %s" % (b["bay"], b["dev"], temp, state),
                      "%s %s" % (b.get("size", ""), b.get("model", ""))))
    for a in arrays:
        if a["progress"]:
            state = "%s %.0f%%" % a["progress"]
        elif a["state"] != "active":
            state = a["state"]
        elif "_" in a["map"]:
            state = "DEGRADED"
        else:
            state = "OK"
        disks = "%s/%s" % (a["active"], a["members"]) \
            if a["members"] else ""
        pages.append((" ".join(x for x in (a["name"], a["level"], disks)
                               if x),
                      ("%s [%s]" % (state, a["map"])) if a["map"]
                      else state))
    for name, used, free, size in vols:
        pages.append(("%s %d%%" % (name[:LCD_WIDTH - 5], used),
                      "%s free/%s" % (bytes_text(free), bytes_text(size))))
    if any(uptime):
        pages.append(uptime)
    if power:
        pages.append(POWER_PAGE)
    return pages


class LcdPanel:
    """Shows the daemon's status on the LCD; SELECT next page, ENTER
    previous page. Any button lights the backlight, which goes off after
    `timeout` seconds without a press (0 = always on). A new problem
    lights it and jumps to the Status page.

    With `power`, the last page opens a menu with ENTER: SELECT picks
    Cancel, Reboot or Shut down, ENTER chooses, and a second ENTER on
    "Sure?" runs it. Anything else, or 15 s without a press, cancels.
    """

    MENU = ("Cancel", "Reboot", "Shut down")
    COMMANDS = {"Reboot": ["systemctl", "reboot"],
                "Shut down": ["systemctl", "poweroff"]}
    MENU_TIMEOUT = 15

    def __init__(self, lcd, timeout, power=False, clock=time.monotonic,
                 runner=subprocess.Popen):
        self.lcd = lcd
        self.timeout = timeout
        self.power = power
        self.clock = clock
        self.runner = runner
        self.page = 0
        self.touched = clock()
        self.status = {}
        self.problems = []
        self.hostname = os.uname().nodename.split(".")[0]
        self.interfaces = []
        self.interfaces_time = None
        self.volumes = []
        self.menu = None      # index in MENU while the menu is open
        self.sure = False     # asking for confirmation
        self.farewell = None  # last message, once a power action started
        self.night = False
        self.stopping = False

    def pages(self):
        return lcd_pages(self.status, self.hostname, self.interfaces,
                         uptime_text(), self.power,
                         md_arrays(read(MDSTAT_FILE) or ""), self.volumes)

    def status_page(self):
        return max(1, len(self.interfaces))

    def update(self, status):
        """Called by the fan loop with each new status."""
        problems = status.get("problems") or []
        if problems and problems != self.problems and self.menu is None:
            self.page = self.status_page()
            self.touched = self.clock()
        self.problems = problems
        self.status = status

    def press(self, button):
        asleep = self.lcd.lit is False
        self.touched = self.clock()
        if asleep or self.farewell:
            return  # the first press only wakes the panel
        if self.menu is not None:
            self.press_menu(button)
            return
        pages = self.pages()
        self.page %= len(pages)
        if button == LCD_ENTER and pages[self.page] == POWER_PAGE:
            self.menu, self.sure = 0, False
        elif button == LCD_SELECT:
            self.page += 1
        elif button == LCD_ENTER:
            self.page -= 1

    def press_menu(self, button):
        choice = self.MENU[self.menu]
        if button == LCD_SELECT:
            if self.sure:
                self.menu, self.sure = None, False   # "no"
            else:
                self.menu = (self.menu + 1) % len(self.MENU)
        elif button == LCD_ENTER:
            if choice == "Cancel":
                self.menu = None
            elif not self.sure:
                self.sure = True
            else:
                self.menu, self.sure = None, False
                self.farewell = ("Rebooting..." if choice == "Reboot"
                                 else "Shutting down", "Please wait")
                log.warning("%s requested on the front LCD", choice)
                self.runner(self.COMMANDS[choice])

    def screen(self):
        if self.farewell:
            return self.farewell
        if self.menu is not None:
            choice = self.MENU[self.menu]
            if self.sure:
                return ("%s? Sure?" % choice, "ENTER yes SEL no")
            return ("> " + choice, "SEL next ENTER ok")
        pages = self.pages()
        self.page %= len(pages)
        return pages[self.page]

    def refresh(self):
        now = self.clock()
        if self.interfaces_time is None or now - self.interfaces_time > 30:
            self.interfaces = network_interfaces()
            self.volumes = volumes()
            self.interfaces_time = now
        idle = now - self.touched
        if self.menu is not None and idle > self.MENU_TIMEOUT:
            self.menu, self.sure = None, False
        if self.night:   # only after a press or a new problem
            lit = idle < (self.timeout or 60)
        else:
            lit = not self.timeout or idle < self.timeout
        self.lcd.backlight(bool(self.farewell) or lit)
        self.lcd.show(self.screen())

    def loop(self):
        self.lcd.backlight(True)
        while not self.stopping:
            try:
                for button in self.lcd.buttons(LCD_REFRESH):
                    self.press(button)
                self.refresh()
            except OSError as e:
                log.error("LCD: %s", e)
                time.sleep(LCD_REFRESH)

    def start(self):
        import threading
        thread = threading.Thread(target=self.loop, name="lcd", daemon=True)
        thread.start()
        return thread

    def stop(self, thread=None):
        self.stopping = True
        if thread:
            thread.join(LCD_REFRESH + 2)
        if self.farewell:
            # Leave the message lit while the system goes down.
            self.lcd.show(self.farewell)
            os.close(self.lcd.fd)
        else:
            self.lcd.close(("openmediavault", "qnapx39d stopped"))

# --------------------------------------------------------------------------
# Fan curve
# --------------------------------------------------------------------------

def curve(temp, low, high, minpwm, maxpwm):
    """Linear from minpwm at `low` to maxpwm at `high`."""
    if temp <= low:
        return minpwm
    if temp >= high:
        return maxpwm
    return round(minpwm + (maxpwm - minpwm) * (temp - low) / (high - low))


def sources(config, cpu, system, disks):
    """[(source, hottest temperature, low, high)] for the enabled sources
    that have a reading."""
    result = []
    for key, readings in (("cpu", cpu), ("sys", system), ("disk", disks)):
        use = {"cpu": "usecpu", "sys": "usesystem", "disk": "usedisk"}[key]
        temps = [t for _, t in readings]
        if config[use] and temps:
            result.append((key, max(temps), config[key + "low"],
                           config[key + "high"]))
    return result


# Fan modes like QTS Smart Fan, tuned for the TS-639 Pro (its board
# sensors idle near 40 C): (low, high) per source and the PWM range.
PRESETS = {
    "quiet": {"cpulow": 65, "cpuhigh": 90, "syslow": 48, "syshigh": 63,
              "disklow": 40, "diskhigh": 52, "minpwm": 64, "maxpwm": 200},
    "normal": {"cpulow": 60, "cpuhigh": 85, "syslow": 45, "syshigh": 60,
               "disklow": 38, "diskhigh": 50, "minpwm": 77, "maxpwm": 255},
    "performance": {"cpulow": 55, "cpuhigh": 80, "syslow": 42,
                    "syshigh": 55, "disklow": 35, "diskhigh": 45,
                    "minpwm": 100, "maxpwm": 255},
}


def is_night(now, start, end):
    """True when the local time `now` (struct_time) is between start and
    end ("HH:MM"), the night possibly crossing midnight."""
    def minutes(text):
        h, m = text.split(":")
        return int(h) * 60 + int(m)
    try:
        a, b = minutes(start), minutes(end)
    except (ValueError, AttributeError):
        return False
    t = now.tm_hour * 60 + now.tm_min
    return a <= t < b if a <= b else (t >= a or t < b)


def target_pwm(config, srcs, current):
    """PWM for this poll. Rises at once; falls only once every source is
    `hysteresis` degrees below the point that asked for the current speed.
    No readings at all: full speed."""
    if config["fanmode"] == "manual":
        return config["manualpwm"]
    if not srcs:
        return PWM_MAX
    if any(t >= high + CRITICAL_MARGIN for _, t, _, high in srcs):
        return PWM_MAX
    lo, hi = config["minpwm"], config["maxpwm"]
    wanted = max(curve(t, low, high, lo, hi) for _, t, low, high in srcs)
    if current is None or wanted >= current:
        return wanted
    hyst = config["hysteresis"]
    held = max(curve(t + hyst, low, high, lo, hi)
               for _, t, low, high in srcs)
    return max(wanted, min(current, held))


# --------------------------------------------------------------------------
# Fault emails (adapted from qnapd in openmediavault-qnap)
# --------------------------------------------------------------------------

# A volume this full is a problem.
VOLUME_FULL_PERCENT = 95
SOURCE_NAMES = {"cpu": "CPU", "sys": "system", "disk": "disk"}


def extra_problems(srcs, vols, full=None):
    """Critical temperatures and full volumes, as stable short strings."""
    full = full or VOLUME_FULL_PERCENT
    problems = ["%s temperature critical" % SOURCE_NAMES.get(name, name)
                for name, temp, _, high in srcs
                if temp >= high + CRITICAL_MARGIN]
    problems += ["volume %s full" % name for name, used, _, _ in vols
                 if used >= full]
    return problems


def send_mail(subject, body):
    """Mail root; OMV's postfix forwards it to the notification address."""
    message = "To: root\nSubject: %s\n\n%s\n" % (subject, body)
    try:
        subprocess.run(["/usr/sbin/sendmail", "-t"], input=message,
                       text=True, capture_output=True, timeout=30,
                       check=True)
    except (OSError, subprocess.SubprocessError) as e:
        log.warning("Cannot send notification: %s", e)


class Notifier:
    """Mails when hardware problems appear and when they clear, if OMV
    notifications are on for this plugin. A problem must last
    HOLD_SECONDS first, so a one-off glitch sends no mail."""

    HOLD_SECONDS = 60

    def __init__(self, enabled, mail=None):
        self.enabled = enabled
        self.mail = mail or send_mail
        self.first_seen = {}
        self.reported = set()

    def update(self, problems, now):
        problems = set(problems)
        self.first_seen = {p: self.first_seen.get(p, now) for p in problems}
        confirmed = {p for p, t in self.first_seen.items()
                     if now - t >= self.HOLD_SECONDS}
        new = confirmed - self.reported
        cleared = self.reported - problems
        self.reported = (self.reported | new) - cleared
        if self.enabled and (new or cleared):
            host = socket.gethostname()
            if new:
                subject = "QNAP hardware on %s: %s" % (host, sorted(new)[0])
                if len(new) > 1:
                    subject += " (+%d more)" % (len(new) - 1)
            else:
                subject = "QNAP hardware on %s: back to normal" % host
            lines = ["New: " + p for p in sorted(new)] + \
                ["Cleared: " + p for p in sorted(cleared)] + \
                ["", "Current problems: %s" % (", ".join(sorted(
                    self.reported)) or "none"),
                 "Details: System > QNAP > Status and Disks."]
            self.mail(subject, "\n".join(lines))
        return new, cleared


# --------------------------------------------------------------------------
# Beeper and buttons (adapted from qnapd in openmediavault-qnap)
# --------------------------------------------------------------------------

# OMV writes each Scheduled Task to a script named after its uuid.
TASK_SCRIPT = re.compile(r"^/var/lib/openmediavault/cron\.d/"
                         r"userdefined-[0-9a-f]{8}(-[0-9a-f]{4}){3}-"
                         r"[0-9a-f]{12}$")


class Beeper:
    """QTS beeps on the PC speaker (PIT channel 2 and port 0x61, checked on
    a TS-639 Pro). S = short, L = long; one pattern at a time, in the
    background."""

    TONE_HZ = 1000
    SHORT, LONG, GAP = 0.5, 1.5, 0.4
    PATTERNS = {
        "startup": "S", "reset": "S",
        "usbcopy-failed": "SSS",
        "fan-failure": "LLL",
        "storage": "LL",  # a RAID degraded, or a rebuild started
    }

    def __init__(self, enabled, io=None):
        self.enabled = enabled
        self.io = io
        self.lock = threading.Lock()

    def beep(self, event, wait=False):
        if not self.enabled:
            return
        thread = threading.Thread(target=self.play,
                                  args=(self.PATTERNS[event],), daemon=True)
        thread.start()
        if wait:
            thread.join(10)

    def tone(self, on):
        if on:
            divisor = 1193182 // self.TONE_HZ
            self.io.outb(0x43, 0xB6)  # channel 2, square wave
            self.io.outb(0x42, divisor & 0xFF)
            self.io.outb(0x42, divisor >> 8)
            self.io.outb(0x61, self.io.inb(0x61) | 0x03)
        else:
            self.io.outb(0x61, self.io.inb(0x61) & 0xFC)

    def play(self, pattern):
        with self.lock:
            try:
                if self.io is None:
                    self.io = PortIO()
                for i, mark in enumerate(pattern):
                    if i:
                        time.sleep(self.GAP)
                    self.tone(True)
                    try:
                        time.sleep(self.LONG if mark == "L" else self.SHORT)
                    finally:
                        self.tone(False)
            except OSError as e:
                log.warning("Cannot beep: %s", e)


def run_task(task):
    """Run an OMV Scheduled Task's script as its user; True on exit 0."""
    script, user = task["script"], task.get("user") or "root"
    if not TASK_SCRIPT.match(script) or not os.access(script, os.X_OK):
        log.warning("Scheduled task %s not found; save it in OMV first",
                    script)
        return False
    cmd = [script] if user == "root" else ["runuser", "-u", user, "--",
                                           script]
    try:
        done = subprocess.run(cmd, stdin=subprocess.DEVNULL,
                              stdout=subprocess.DEVNULL,
                              stderr=subprocess.PIPE, text=True)
    except OSError as e:
        log.warning("Cannot run %s: %s", script, e)
        return False
    if done.returncode:
        log.warning("%s exited with %d: %s", script, done.returncode,
                    done.stderr.strip()[-500:])
    return done.returncode == 0


class UsbLed:
    """The blue USB LED (GP50, active-low), blinked in software while the
    USB Copy task runs. The LED loop leaves it alone meanwhile."""

    PIN = (5, 0)
    BLINK = 0.4

    def __init__(self, io, base, panel=None):
        self.io = io
        self.base = base
        self.panel = panel
        self.stop = threading.Event()

    def set(self, on):
        s, bit = self.PIN
        addr = self.base + s - 1
        value = self.io.inb(addr)
        self.io.outb(addr, value & ~(1 << bit) if on else value | 1 << bit)

    def claim(self, busy):
        if self.panel:
            self.panel.usb_busy = busy

    def blink_until(self, done):
        """Blink until the `done` event is set."""
        on = False
        while not done.wait(self.BLINK):
            on = not on
            self.set(on)


class Buttons:
    """USB Copy (GP16) and Reset (GP17), both active-low. USB Copy runs its
    Scheduled Task when released; Reset runs its task when held RESET_HOLD
    seconds (shorter and RESET_LONG or longer holds do nothing). One task
    runs at a time."""

    USBCOPY = (1, 6)   # GP16
    RESET = (1, 7)     # GP17
    POLL = 0.05
    RESET_HOLD = 3
    RESET_LONG = 10
    DONE_SECONDS = 10  # USB LED solid after a successful copy

    def __init__(self, config, beeper, io, base, usb_led=None,
                 runner=run_task):
        self.config = config
        self.beeper = beeper
        self.io = io
        self.base = base
        self.usb_led = usb_led
        self.runner = runner
        self.pressed = {}
        self.busy = threading.Lock()
        self.stop = threading.Event()
        self.thread = None

    def read(self):
        """{"usbcopy": pressed?, "reset": pressed?}"""
        value = self.io.inb(self.base + self.USBCOPY[0] - 1)
        return {"usbcopy": not value >> self.USBCOPY[1] & 1,
                "reset": not value >> self.RESET[1] & 1}

    def handle(self, name, down, now):
        """A button changed; returns the task started, if any."""
        if down:
            self.pressed[name] = now
            return None
        if name not in self.pressed:
            return None
        held = now - self.pressed.pop(name)
        if name == "usbcopy":
            log.info("USB Copy pressed")
            return self.start_task("usbcopy", self.config.get("usbcopy"))
        log.info("Reset held %.1f s", held)
        if held < self.RESET_HOLD or held >= self.RESET_LONG:
            return None
        self.beeper.beep("reset")
        return self.start_task("reset", self.config.get("reset"))

    def start_task(self, name, task):
        if not task:
            return None
        if not self.busy.acquire(blocking=False):
            log.info("%s ignored: a button task is still running", name)
            return None
        thread = threading.Thread(target=self.run, args=(name, task),
                                  name=name, daemon=True)
        thread.start()
        return name

    def run(self, name, task):
        blinker = None
        done = threading.Event()
        try:
            if name == "usbcopy" and self.usb_led:
                self.usb_led.claim(True)
                blinker = threading.Thread(target=self.usb_led.blink_until,
                                           args=(done,), daemon=True)
                blinker.start()
            ok = self.runner(task)
            log.info("%s task %s", name, "finished" if ok else "failed")
            done.set()
            if blinker:
                blinker.join(2)
            if name == "usbcopy":
                if self.usb_led:
                    self.usb_led.set(ok)
                if ok:
                    self.stop.wait(self.DONE_SECONDS)
                else:
                    self.beeper.beep("usbcopy-failed")
        except OSError as e:
            log.warning("%s: %s", name, e)
        finally:
            done.set()
            if self.usb_led and name == "usbcopy":
                self.usb_led.claim(False)
            self.busy.release()

    def poll(self, now):
        state = self.read()
        for name, down in state.items():
            if down != (name in self.pressed):
                self.handle(name, down, now)

    def start(self):

        def loop():
            while not self.stop.is_set():
                try:
                    self.poll(time.monotonic())
                except OSError as e:
                    log.warning("Button input failed: %s", e)
                    self.stop.wait(5)
                self.stop.wait(self.POLL)
        self.thread = threading.Thread(target=loop, name="buttons",
                                       daemon=True)
        self.thread.start()

    def finish(self):
        self.stop.set()
        if self.thread:
            self.thread.join(2)


def storage_state(mdstat):
    """"ok", or "degraded" / "rebuilding" for the RAID arrays."""
    arrays = md_arrays(mdstat)
    if any(a["progress"] and a["progress"][0] in ("recovery", "reshape")
           for a in arrays):
        return "rebuilding"
    if any("_" in a["map"] for a in arrays):
        return "degraded"
    return "ok"


class Alarms:
    """QTS beeps: a stopped fan every FAN_ALARM_SECONDS; the RAID turning
    degraded or starting a rebuild (not the state found at start)."""

    FAN_ALARM_SECONDS = 300

    def __init__(self, beeper):
        self.beeper = beeper
        self.fan_beep = None
        self.storage_seen = None

    def update(self, fans, storage, now):
        if any(f.get("failed") for f in fans):
            if self.fan_beep is None or \
                    now - self.fan_beep >= self.FAN_ALARM_SECONDS:
                self.beeper.beep("fan-failure")
                self.fan_beep = now
        else:
            self.fan_beep = None
        if self.storage_seen is not None and storage != "ok" and \
                storage != self.storage_seen:
            self.beeper.beep("storage")
        self.storage_seen = storage


# --------------------------------------------------------------------------
# Daemon
# --------------------------------------------------------------------------

def load_config(path=None):
    path = path or CONFIG_FILE
    config = dict(DEFAULTS)
    try:
        with open(path) as f:
            config.update(json.load(f))
    except (OSError, ValueError) as e:
        log.warning("Using defaults, cannot read %s: %s", path, e)
    for key in ("interval", "manualpwm", "minpwm", "maxpwm", "hysteresis",
                "cpulow", "cpuhigh", "syslow", "syshigh", "disklow",
                "diskhigh", "diskinterval", "lcdtimeout"):
        config[key] = int(config[key])
    for key in ("enable", "usecpu", "usesystem", "usedisk", "leds", "lcd",
                "lcdpower", "notify", "beep"):
        config[key] = bool(config[key])
    for key in ("usbcopy", "reset"):
        task = config.get(key)
        config[key] = {"script": task["script"],
                       "user": str(task.get("user") or "root")} \
            if isinstance(task, dict) and \
            isinstance(task.get("script"), str) else None
    config["volumefull"] = int(config["volumefull"])
    if config["powerloss"] not in ("on", "off", "bios"):
        config["powerloss"] = "bios"
    for key in ("statusled", "night"):
        config[key] = bool(config[key])
    config.update(PRESETS.get(config["fanmode"], {}))
    config["fans"] = parse_list(config["fans"], int)
    config["systemsensors"] = parse_list(config["systemsensors"])
    config["bays"] = parse_list(config["bays"])
    return config


def write_status(status, path=None):
    path = path or STATUS_FILE
    tmp = path + ".tmp"
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(tmp, "w") as f:
        json.dump(status, f)
    os.replace(tmp, path)


def failsafe(config):
    # systemd sets SERVICE_RESULT for ExecStopPost: anything but success
    # means the daemon crashed or was killed.
    result = os.environ.get("SERVICE_RESULT")
    if result not in (None, "", "success") and config["notify"]:
        send_mail("QNAP hardware on %s: qnapx39d stopped unexpectedly"
                  % socket.gethostname(),
                  "qnapx39d exited (%s). The fans are at full speed until "
                  "systemd restarts it. See `journalctl -u qnapx39d`."
                  % result)
    sio = SuperIO.find()
    if not sio:
        log.error("No it87 sensor chip found: is the it87 module loaded?")
        return 1
    for n in config["fans"]:
        try:
            sio.set_pwm(n, PWM_MAX)
        except OSError as e:
            log.error("Failed to set pwm%d to full speed: %s", n, e)
    return 0


LPC_CONFIG = "/sys/bus/pci/devices/0000:00:1f.0/config"
GEN_PMCON_3 = 0xA4      # ICH7 LPC bridge, bit 0 AFTERG1_EN (RTC well)


def set_power_loss(mode, path=None):
    """Set what the Intel ICH does when power returns after a cut.

    AFTERG1_EN = 0 powers the NAS on, 1 leaves it off. The bit lives in
    the RTC well, so it holds until the BIOS writes it again at boot.
    Returns the new register value, or None if nothing was changed.
    """
    if mode not in ("on", "off"):
        return None
    path = path or LPC_CONFIG
    fd = os.open(path, os.O_RDWR)
    try:
        head = os.pread(fd, 12, 0)
        vendor = head[0] | head[1] << 8
        if vendor != 0x8086 or head[11] != 0x06 or head[10] != 0x01:
            raise OSError("00:1f.0 is not an Intel LPC bridge")
        old = os.pread(fd, 1, GEN_PMCON_3)[0]
        new = (old & ~1) if mode == "on" else (old | 1)
        if new != old:
            os.pwrite(fd, bytes([new]), GEN_PMCON_3)
        return new
    finally:
        os.close(fd)


class Stop(Exception):
    pass


def run(config):
    def stop(signum, frame):
        raise Stop()

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)

    sio = SuperIO.find()
    if not sio:
        log.error("No it87 sensor chip found: is the it87 module loaded?")
        return 1
    log.info("Using %s at %s, fans %s", sio.name, sio.path, config["fans"])
    try:
        if set_power_loss(config["powerloss"]) is not None:
            log.info("After a power cut the NAS stays %s",
                     "off" if config["powerloss"] == "off" else "on")
    except OSError as e:
        log.warning("Cannot set the power-loss behaviour: %s", e)
    panel = None
    if config["leds"] or config["statusled"]:
        try:
            panel = FrontPanel.open()
        except OSError as e:
            log.warning("Front panel LEDs disabled: %s", e)
    lcd = lcd_thread = None
    if config["lcd"]:
        try:
            lcd = LcdPanel(Lcd.open(config["lcdport"]), config["lcdtimeout"],
                           config["lcdpower"])
            lcd_thread = lcd.start()
        except OSError as e:
            log.warning("Front LCD disabled: %s", e)
            lcd = None
    beeper = Beeper(config["beep"])
    alarms = Alarms(beeper)
    buttons = None
    try:
        io = PortIO()
        with SuperIOConfig(io) as cfg:
            chip, base, _ = cfg.gpio()
        if chip == 0x8718 and base:
            usb_led = UsbLed(PortIO(), base, panel)
            buttons = Buttons(config, beeper, PortIO(), base, usb_led)
            buttons.start()
    except OSError as e:
        log.warning("Buttons disabled: %s", e)
    beeper.beep("startup")
    disks = DiskTemps(config["diskinterval"])
    current = None
    zero_rpm = {n: 0 for n in config["fans"]}
    problems_before = None
    notifier = Notifier(config["notify"])
    try:
        while True:
            now = time.time()
            cpu = cpu_temps()
            system = sio.temps(config["systemsensors"])
            # Disks are read for the LEDs and LCD too, even when their
            # temperatures do not drive the fans.
            disk = disks.get(now) \
                if (config["usedisk"] or panel or lcd) else []
            srcs = sources(config, cpu, system,
                           disk if config["usedisk"] else [])
            pwm = target_pwm(config, srcs, current)
            fans = []
            for n in config["fans"]:
                try:
                    actual = sio.set_pwm(n, pwm)
                except OSError as e:
                    log.error("Failed to set pwm%d: %s", n, e)
                    actual = None
                if actual is not None and abs(actual - pwm) > 2:
                    log.warning("pwm%d reads back %s, wanted %s",
                                n, actual, pwm)
                rpm = sio.rpm(n)
                zero_rpm[n] = zero_rpm[n] + 1 \
                    if (rpm == 0 and pwm >= FAN_FAIL_PWM) else 0
                if zero_rpm[n] == FAN_FAIL_POLLS:
                    log.error("Fan %d reads 0 RPM at PWM %d: fan failed?",
                              n, pwm)
                fans.append({"name": "fan%d" % n, "rpm": rpm, "pwm": actual,
                             "failed": zero_rpm[n] >= FAN_FAIL_POLLS})
            if current != pwm:
                log.info("Fan PWM %s -> %d (%s)", current, pwm,
                         ", ".join("%s %.0f°C" % (s, t)
                                   for s, t, _, _ in srcs) or "no readings")
            current = pwm
            ok, failed_bays, problems = panel_state(
                fans, disks, read(MDSTAT_FILE) or "", disk_bays(config["bays"]))
            night = config["night"] and is_night(
                time.localtime(now), config["nightstart"], config["nightend"])
            more = extra_problems(srcs, volumes(), config["volumefull"])
            ok, problems = ok and not more, problems + more
            notifier.update(problems, now)
            storage = storage_state(read(MDSTAT_FILE) or "")
            alarms.update(fans, storage, now)
            bays = bay_info(config["bays"], disk, disks.asleep, failed_bays)
            if problems != problems_before:
                if problems:
                    log.warning("Status red: %s", "; ".join(problems))
                elif problems_before is not None:
                    log.info("Status green: all well again")
                problems_before = problems
            if panel:
                try:
                    panel.show(ok, failed_bays, usb_disk_present(),
                               config["statusled"], config["leds"], night)
                except OSError as e:
                    log.error("Failed to set the LEDs: %s", e)
            st = {
                "time": now, "interval": config["interval"],
                "pwm": pwm, "duty": round(pwm * 100 / PWM_MAX),
                "fans": fans,
                "temps": {"cpu": cpu, "system": system, "disk": disk},
                "problems": problems,
                "bays": bays,
                "storage": storage,
            }
            if lcd:
                lcd.night = night
                lcd.update(st)
            write_status(st)
            time.sleep(config["interval"])
    except Stop:
        log.info("Stopping")
    finally:
        failsafe(config)
        if buttons:
            buttons.finish()
        if panel:
            try:
                panel.restore()
            except OSError as e:
                log.error("Failed to restore the LEDs: %s", e)
        if lcd:
            try:
                lcd.stop(lcd_thread)
            except OSError as e:
                log.error("Failed to switch the LCD off: %s", e)
    return 0


# --------------------------------------------------------------------------
# status / collectd
# --------------------------------------------------------------------------

def read_status(path=None):
    """The daemon's last status, or None when missing or stale."""
    path = path or STATUS_FILE
    try:
        with open(path) as f:
            status = json.load(f)
    except (OSError, ValueError):
        return None
    age = time.time() - status.get("time", 0)
    if age > STATUS_STALE_POLLS * max(2, status.get("interval", 10)):
        return None
    return status


def live_status(config):
    """Readings without the daemon (disks are not queried, so none wake)."""
    sio = SuperIO.find()
    fans = []
    system = []
    if sio:
        system = sio.temps(config["systemsensors"])
        fans = [{"name": "fan%d" % n, "rpm": sio.rpm(n), "pwm": sio.pwm(n),
                 "failed": False} for n in config["fans"]]
    return {"time": time.time(), "running": False, "pwm": None,
            "duty": None, "fans": fans,
            "temps": {"cpu": cpu_temps(), "system": system, "disk": []}}


def status(config):
    result = read_status()
    if result is None:
        result = live_status(config)
    else:
        result["running"] = True
    return result


def collectd_values(st):
    """[(type-instance, value)]: hottest temperature per source, every fan
    speed and the duty."""
    values = []
    for source, readings in sorted((st.get("temps") or {}).items()):
        temps = [t for _, t in readings]
        if temps:
            values.append(("temperature-" + source, max(temps)))
    for fan in st.get("fans") or []:
        if fan.get("rpm") is not None:
            values.append(("fanspeed-" + fan["name"], fan["rpm"]))
    if st.get("duty") is not None:
        values.append(("percent-duty", st["duty"]))
    return values


def collectd():
    host = os.environ.get("COLLECTD_HOSTNAME", "localhost")
    interval = int(float(os.environ.get("COLLECTD_INTERVAL", "60")))
    try:
        while True:
            st = read_status()
            for ident, value in collectd_values(st or {}):
                print('PUTVAL "%s/exec-qnapx39/%s" interval=%d N:%s' %
                      (host, ident, interval, value), flush=True)
            time.sleep(interval)
    except (BrokenPipeError, KeyboardInterrupt):
        return 0


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("command",
                        choices=["run", "failsafe", "status", "collectd"])
    parser.add_argument("--config", default=CONFIG_FILE)
    args = parser.parse_args(argv)
    logging.basicConfig(level=logging.INFO,
                        format="%(levelname)s: %(message)s")
    if args.command == "collectd":
        return collectd()
    config = load_config(args.config)
    if args.command == "run":
        return run(config)
    if args.command == "failsafe":
        return failsafe(config)
    print(json.dumps(status(config), indent=2))
    return 0


if __name__ == "__main__":
    sys.exit(main())
